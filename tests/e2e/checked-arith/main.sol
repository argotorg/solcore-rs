pragma solcore;

// Exercises checked (reverting) integer arithmetic in std.signed / std.unsigned
// and uint256 in std. Every value-producing op (+ - * / %) reverts with a
// Solidity Panic on overflow/underflow (code 0x11) or division/modulo by zero
// (code 0x12); signed division of the minimum value by -1 also panics (0x11).
//
// Operands are passed in as parameters (never constant-folded), each in range
// for its type, so the revert comes from the arithmetic itself, not from ABI
// decoding. Covered widths: uint8 (narrow unsigned), uint256 (wide unsigned),
// int8 (narrow signed), int256 (wide signed) — the two distinct code paths in
// the checked helpers (narrow range-check vs. wide wrap/sign/div-back check).
import * from std;
import * from std.signed;
import * from std.unsigned;
import * from std.dispatch;

