contract CheckedArith {
    constructor() {}

    // ---- uint256 (wide unsigned) ----
    function addU256(a: uint256, b: uint256) public returns (uint256) {
        return a + b;
    }
    function subU256(a: uint256, b: uint256) public returns (uint256) {
        return a - b;
    }
    function mulU256(a: uint256, b: uint256) public returns (uint256) {
        return a * b;
    }
    function divU256(a: uint256, b: uint256) public returns (uint256) {
        return a / b;
    }
    function modU256(a: uint256, b: uint256) public returns (uint256) {
        return a % b;
    }

    // ---- uint8 (narrow unsigned) ----
    function addU8(a: uint8, b: uint8) public returns (uint8) {
        return a + b;
    }
    function subU8(a: uint8, b: uint8) public returns (uint8) {
        return a - b;
    }
    function mulU8(a: uint8, b: uint8) public returns (uint8) {
        return a * b;
    }
    function divU8(a: uint8, b: uint8) public returns (uint8) {
        return a / b;
    }
    function modU8(a: uint8, b: uint8) public returns (uint8) {
        return a % b;
    }

    // ---- int256 (wide signed) ----
    function addI256(a: int256, b: int256) public returns (int256) {
        return a + b;
    }
    function subI256(a: int256, b: int256) public returns (int256) {
        return a - b;
    }
    function mulI256(a: int256, b: int256) public returns (int256) {
        return a * b;
    }
    function divI256(a: int256, b: int256) public returns (int256) {
        return a / b;
    }
    function modI256(a: int256, b: int256) public returns (int256) {
        return a % b;
    }

    // ---- int8 (narrow signed) ----
    function addI8(a: int8, b: int8) public returns (int8) {
        return a + b;
    }
    function subI8(a: int8, b: int8) public returns (int8) {
        return a - b;
    }
    function mulI8(a: int8, b: int8) public returns (int8) {
        return a * b;
    }
    function divI8(a: int8, b: int8) public returns (int8) {
        return a / b;
    }
    function modI8(a: int8, b: int8) public returns (int8) {
        return a % b;
    }
}
