import std.{*};

contract Arithmetic {
  constructor() {}

  // #[(0, 1) -> 1]
  // #[(1, 1) -> 2]
  public function add(x: uint256, y: uint256) -> uint256 {
    return Add.add(x, y);
  }

  // #[(10, 2) -> 8]
  // #[(2, 0) -> 2]
  public function sub(x: uint256, y: uint256) -> uint256 {
    return Sub.sub(x, y);
  }
}
