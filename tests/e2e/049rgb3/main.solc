import std;
import std.dispatch;

enum RGB { Red(word), Green(word), Blue(word) }

contract RGB3 {

  function choose(c: RGB) returns (word) {
    let res: word;
    match (c) { case RGB.Red(x) { assembly { res := add(x,1) } } case RGB.Green(x) { assembly { res := add(x,2) } } case RGB.Blue(x) { assembly { res := add(x,3) } } }
      return res;
  }
  // #[() -> 44]
  function run() public returns (uint256) {
    return uint256.uint256(choose(RGB.Green(42)));
  }
}
