import std;
import std.dispatch;

contract Option {
  enum Option<a> { None, Some(a) }

  function just(x: word) returns (Option<word>) { return Option.Some(x); }

  function maybe(n: word, o: Option<word>) returns (word) {
    match (o) { case Option.None { return n; } case Option.Some(x) { return x; } }
  }

  function join(mmx: Option<Option<word>>) returns (Option<word>) {
    let result = Option.None;
    match (mmx) { case Option.Some(Option.Some(x)) { result = Option.Some(x); } case Option.None { result = Option.None; } case Option.Some(Option.None) { result = Option.None; } default { result = Option.None; } }
    return result;
  }

  // #[() -> 42]
  function run() public returns (uint256) {
    return uint256.uint256(maybe(0, join(Option.Some(Option.Some(42)))));
  }
}
