import std;
import std.dispatch;

contract Id1 {

  enum Bool { False, True }

  function id(x: word) returns (word) {
    return x ;
  }

  function const(x: word, y: Bool) returns (word) { return x; }

  // #[() -> 42]
  function run() public returns (uint256) {
    return uint256.uint256(const(id(42), Bool.False));
  }
}
