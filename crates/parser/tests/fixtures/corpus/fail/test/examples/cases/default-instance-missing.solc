trait Test<self> { function f(x: self) ; }

enum memory<a> { memory(word) }
enum Proxy<a> { Proxy }

impl Test<memory<memory<word>>> { function f(x: self) {}}

function f<a>(p: Proxy<a>) {
    let x: a memory;
    Test.f(x);
}

function g() {
    f(Proxy.Proxy as Proxy<memory<memory<word>>>); // needs to choose default instance in Test.f
    f(Proxy.Proxy as Proxy<memory<word>>); // needs to choose concrete instance
}
