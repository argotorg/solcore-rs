enum Option<a> { None, Some(a) }

function join(mmx: Option<Option<word>>) returns (Option<word>) {
  match (mmx) { case Option.Some(Option.Some(x)) { return Option.Some(x); } default { return Option.None; } }
}

function main() returns (word) {
  match (join(Option.Some(Option.Some(9)))) { case Option.Some(v) { return v; } case Option.None { return 0; } }
}
