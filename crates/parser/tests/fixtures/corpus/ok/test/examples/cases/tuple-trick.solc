pragma solcore noCoverageCondition Nth;


enum Zero {}
enum Succ<a> {}

enum Proxy<a> { Proxy }

trait Nth<a, b, c> {
  function nth(x: Proxy<a>, y: b) returns (c) ;
}

impl<a, b> Nth<Zero, (a, b), a> {
   function nth(x: Proxy<Zero>, y: (a, b)) returns (a) {
      match (y) { case (a, b) { return a ; } }
   }
}

impl<n, a, b, c> Nth<Succ<n>, (a, b), c> where n: Nth<b, c> {
   function nth(x: Proxy<Succ<n>>, y: (a, b)) returns (c) {
      match (y) { case (a, b) { let predecessorProxy: Proxy<n> = Proxy.Proxy; return Nth.nth(predecessorProxy, b); } }
   }
}

contract C {
  function id(x: word) public returns (word) {
    return x;
  }
  function main() public returns () {
    let p: (word, word, word, ());
    let zeroProxy: Proxy<Zero> = Proxy.Proxy;
    let oneProxy: Proxy<Succ<Zero>> = Proxy.Proxy;
    let twoProxy: Proxy<Succ<Succ<Zero>>> = Proxy.Proxy;
    let x: word = Nth.nth(zeroProxy, p);
    let y: word = Nth.nth(oneProxy, p);
    let z: word = Nth.nth(twoProxy, p);
    id(z);
  }
}
