import * as dot_left from dot_left;
import * as dot_right from dot_right;

function mkLeft() returns (dot_left.LeftOpt) {
  let x: dot_left.LeftOpt = dot_left.LeftOpt.Some(1);
  return x;
}

function main() returns (word) {
  match (mkLeft()) { case dot_left.LeftOpt.Some(v) { return v; } case dot_left.LeftOpt.None { return 0; } }
}
