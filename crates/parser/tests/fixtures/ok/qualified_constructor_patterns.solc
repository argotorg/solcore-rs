contract QualifiedConstructorPatterns {
  enum Option<T> {
    None,
    Some(T),
  }

  function join(mmx: Option<Option<word>>) returns (Option<word>) {
    match (mmx) {
      case Option.None {
        return Option.None;
      }
      case Option.Some(Option.Some(x)) {
        return Option.Some(x);
      }
      case Option.Some(Option.None) {
        return Option.None;
      }
    }
  }
}
