data bytes;
data memory(t) = memory(word);
data storage(t) = storage(word);

forall a b.
class a:CanStore(b) {
  function store(r:a, v:b) -> ();
  function load(r:a) -> b;
}

instance storage(bytes):CanStore(memory(bytes)) {
  function store(dst: storage(bytes), src: memory(bytes)) -> () {
    return ();
  }

  function load(src: storage(bytes)) -> memory(bytes) {
    return memory(0);
  }
}

contract C {
  value : bytes;

  constructor(x : memory(bytes)) {
    value = x;
  }

  public function get() -> memory(bytes) {
    return value;
  }

  function main() -> () {
    return ();
  }
}
