import {wrapper, boxed} from lib;

// A selective import does not waive constructor qualification in either
// pattern or expression position.
function unwrap(u: wrapper) returns (word) {
  match (u) { case wrapper.wrapper(w) { return w; } }
}

function rebox(b: boxed) returns (boxed) {
  match (b) { case boxed.boxed(w) { return boxed.boxed(w); } }
}

function main() returns (word) {
  return unwrap(wrapper.wrapper(3));
}
