data B = A | C;

function choose(x : word) -> B {
  if (x == 0) {
    return B.A;
  }
  return B.C;
}

function onlyA(b : B) -> word {
  match b {
    | B.A => return 1;
  }
}

contract C {
  public function main() -> word {
    let x: word;
    assembly { x := calldataload(0) }
    return onlyA(choose(x));
  }
}
