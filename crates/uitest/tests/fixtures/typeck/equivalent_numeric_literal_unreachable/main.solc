function pick(x: word) returns (word) {
  match (x) {
  case 0x0A { return 0; }
  case 10 { return 1; }
  default { return 2; }
  }
}

function wrapped(x: word) returns (word) {
  match (x) {
  case 0 { return 0; }
  case 115792089237316195423570985008687907853269984665640564039457584007913129639936 { return 1; }
  default { return 2; }
  }
}

function exact(x: integer) returns (word) {
  match (x) {
  case 0 { return 0; }
  case 115792089237316195423570985008687907853269984665640564039457584007913129639936 { return 1; }
  default { return 2; }
  }
}
