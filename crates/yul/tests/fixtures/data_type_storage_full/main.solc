import std;

enum Box { Box(word) }

impl StorageType<Box> {
  function load(ptr: word) returns (Box) {
    return Box.Box(StorageType.load(ptr));
  }

  function store(ptr: word, value: Box) returns () {
    match (value) { case Box.Box(inner) { StorageType.store(ptr, inner); } }
  }
}

impl CanStore<Box storage, Box> {
  function load(ptr: Box storage) returns (Box) {
    let result: Box = StorageType.load(Typedef.rep(ptr));
    return result;
  }

  function store(ptr: Box storage, value: Box) returns () {
    StorageType.store(Typedef.rep(ptr), value);
  }
}

contract DataTypeStorageFull {
  box : Box;

  function main() public returns (word) {
    match (box) { case Box.Box(inner) { return inner; } }
  }
}
