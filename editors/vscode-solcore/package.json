{
  "name": "solcore-language",
  "displayName": "Solcore Language",
  "description": "Syntax highlighting and editor configuration for Solcore .solc files.",
  "version": "0.0.0",
  "publisher": "solcore",
  "license": "Apache-2.0",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "scripts": {
    "test:unit": "node --test test/*.test.js"
  },
  "activationEvents": ["onLanguage:solcore"],
  "extensionKind": ["workspace"],
  "contributes": {
    "languages": [
      {
        "id": "solcore",
        "aliases": ["Solcore", "solc"],
        "extensions": [".solc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "solcore",
        "scopeName": "source.solcore",
        "path": "./syntaxes/solcore.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Solcore",
      "properties": {
        "solcore.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the solcore-lsp executable. Falls back to SOLCORE_LSP_SERVER, then solcore-lsp on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
